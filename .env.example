# 可选覆盖项。未创建 .env 时，Docker Compose 仍会以私有部署默认值启动。
POSTGRES_DB=huddletab
POSTGRES_USER=huddletab
POSTGRES_PASSWORD=huddletab
BETTER_AUTH_URL=http://localhost:5660
APP_BASE_URL=http://localhost:5660
TRUST_PROXY=false
# 获取参考汇率时，Rust 服务需要能够出站访问 https://api.frankfurter.dev 。
# 该数据是日参考汇率，不是实时成交价；无需也不支持配置 API Key。
TZ=Asia/Shanghai

# 默认不需要创建 .env：Compose 使用 HTTP、端口 5660 和 ./data。
# APP_BASE_URL 必须是浏览器实际访问的同源地址；使用 https:// 时 Session Cookie 自动带 Secure。
# TRUST_PROXY=true 仅表示应用位于受控代理之后，且代理会删除客户端 Header 后重新设置唯一的 X-Real-IP。
# 部署 .env 属于私密配置，不要提交；生产环境应使用部署平台提供的密钥管理方式设置密码和密钥。
# DATA_HOST_DIR 与 APP_PORT 仅用于隔离的自动化 Compose 演练，通常无需设置。
