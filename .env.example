# 可选覆盖项。未创建 .env 时，Docker Compose 仍会以私有部署默认值启动。
POSTGRES_DB=huddletab
POSTGRES_USER=huddletab
POSTGRES_PASSWORD=huddletab
BETTER_AUTH_URL=http://localhost:5660
APP_BASE_URL=http://localhost:5660
TRUST_PROXY=false

# 默认不需要创建 .env：Compose 使用 HTTP、端口 5660 和 ./data。
# TRUST_PROXY=true 仅表示应用位于受控代理之后，且代理会重新设置 X-Real-IP。
# DATA_HOST_DIR 与 APP_PORT 仅用于隔离的自动化 Compose 演练，通常无需设置。
